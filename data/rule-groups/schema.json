{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dnd-planner.local/rule-groups",
  "title": "D&D Planner Rule Groups",
  "description": "Schema for D&D Planner rule group YAML files",
  "type": "object",
  "required": ["ruleGroups"],
  "properties": {
    "ruleGroups": {
      "type": "array",
      "description": "Array of rule groups to sync to DynamoDB",
      "items": {
        "$ref": "#/definitions/ruleGroup"
      }
    }
  },
  "definitions": {
    "supportedLocale": {
      "type": "string",
      "enum": ["en", "en-x-tlh"],
      "description": "Supported locales for rule group translations"
    },
    "detailLocale": {
      "type": "object",
      "description": "Translated detail content for a single locale",
      "required": ["body"],
      "properties": {
        "meta": {
          "type": "string",
          "description": "Italic subtitle line"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["labelKey", "value"],
            "properties": {
              "labelKey": { "type": "string" },
              "value": { "type": "string" }
            }
          }
        },
        "body": {
          "type": "string",
          "description": "Markdown body text"
        }
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "required": ["name", "description", "keywords"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name for this rule group in this locale"
        },
        "description": {
          "type": "string",
          "description": "Description for this rule group in this locale"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Search/filter keywords for this rule group in this locale"
        }
      },
      "additionalProperties": false
    },
    "ruleGroup": {
      "type": "object",
      "required": ["id", "translations"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this rule group",
          "examples": ["paladin-level1-divine-sense", "fighter-champion-improved-critical"]
        },
        "translations": {
          "type": "object",
          "description": "Translations keyed by locale code",
          "properties": {
            "en": {
              "$ref": "#/definitions/translation"
            },
            "en-x-tlh": {
              "$ref": "#/definitions/translation"
            }
          },
          "required": ["en", "en-x-tlh"],
          "additionalProperties": false
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of rule groups that must also be assigned when this group is assigned"
        },
        "rules": {
          "type": "array",
          "description": "Array of rules in this rule group",
          "items": {
            "$ref": "#/definitions/rule"
          }
        },
        "settings": {
          "type": "array",
          "description": "Configuration settings presented to the user when this rule group is assigned",
          "items": {
            "$ref": "#/definitions/settingDefinition"
          }
        },
        "condition": {
          "type": "array",
          "description": "Conditions that must be met before this rule group can be assigned to a character",
          "items": {
            "$ref": "#/definitions/ruleGroupCondition"
          }
        },
        "detail": {
          "type": "object",
          "description": "Detail text for rules mode (extracted by publish step, stripped before DynamoDB)",
          "required": ["key", "source", "translations"],
          "properties": {
            "key": {
              "type": "string",
              "description": "Detail key e.g. 'spell/sleep'"
            },
            "source": {
              "type": "string",
              "enum": ["srd52", "srd51", "custom"],
              "description": "Provenance label"
            },
            "translations": {
              "type": "object",
              "description": "Map of locale code to translated detail content",
              "additionalProperties": {
                "$ref": "#/definitions/detailLocale"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ruleGroupCondition": {
      "type": "object",
      "description": "A condition for rule group assignment. Top-level array is AND logic; use type 'or' for OR logic.",
      "oneOf": [
        {
          "required": ["fact", "operator", "value"],
          "properties": {
            "fact": {
              "type": "string",
              "description": "Fact path to check"
            },
            "operator": {
              "$ref": "#/definitions/comparisonOperator"
            },
            "value": {
              "type": "number",
              "description": "Value to compare against"
            }
          }
        },
        {
          "required": ["type", "clauses"],
          "properties": {
            "type": {
              "type": "string",
              "const": "or",
              "description": "OR logic: true if any clause passes"
            },
            "clauses": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ruleGroupCondition"
              },
              "description": "Clauses to evaluate with OR logic"
            }
          }
        }
      ]
    },
    "rule": {
      "type": "object",
      "required": ["id", "activities"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this rule"
        },
        "description": {
          "type": "string",
          "description": "i18n key for rule description"
        },
        "ui": {
          "type": "object",
          "description": "UI-specific configuration",
          "properties": {
            "model": {
              "type": "string",
              "description": "UI model type (e.g., 'move')"
            },
            "section": {
              "type": "string",
              "description": "UI section label"
            },
            "name": {
              "type": "string",
              "description": "i18n key for display name"
            },
            "packBehind": {
              "type": "string",
              "description": "Rule ID to pack this choice behind (collapsible group)"
            },
            "sliderMin": {
              "type": "number",
              "description": "Minimum value for the ability-score model slider"
            },
            "sliderMax": {
              "type": "number",
              "description": "Maximum value for the ability-score model slider"
            },
            "stats": {
              "type": "array",
              "description": "Stats to display in the stats column",
              "items": {
                "$ref": "#/definitions/statEntry"
              }
            },
            "disadvantageFact": {
              "type": "string",
              "description": "Fact path indicating disadvantage on this roll"
            },
            "outcomeKey": {
              "type": "string",
              "description": "i18n key for contest outcome label"
            },
            "vsKey": {
              "type": "string",
              "description": "i18n key for 'vs' label in contested actions"
            },
            "followups": {
              "type": "array",
              "description": "Followup action buttons available on this rule",
              "items": {
                "$ref": "#/definitions/followup"
              }
            },
            "countDown": {
              "type": "number",
              "description": "Remaining rounds for a timed effect (decremented each end turn)"
            },
            "duration": {
              "type": "number",
              "description": "Total rounds for a timed effect (constant)"
            },
            "saveType": {
              "type": "string",
              "description": "Ability score type for saving throw (e.g., 'WIS')"
            },
            "saveFact": {
              "type": "string",
              "description": "Fact path for the save DC value (e.g., 'spellcasting.saveDC')"
            },
            "showDC": {
              "type": "boolean",
              "description": "Show the save DC display for spell-save model"
            },
            "dieSides": {
              "type": "number",
              "description": "Number of sides on the smite die (default 8 for d8)"
            },
            "annotationLabels": {
              "type": "array",
              "description": "Labels this rule responds to for annotation matching (e.g., 'attack.melee')",
              "items": {
                "type": "string"
              }
            },
            "primaryControl": {
              "type": "object",
              "description": "Primary UI control configuration (e.g., dice-line, slider)",
              "additionalProperties": true
            },
            "secondaryControl": {
              "type": "object",
              "description": "Secondary UI control configuration",
              "additionalProperties": true
            },
            "information": {
              "type": "array",
              "description": "Informational UI elements to display (e.g., text, countdown)",
              "items": {
                "type": "object",
                "additionalProperties": true
              }
            },
            "intents": {
              "type": "object",
              "description": "Map of intent verb to sub-bucket label. Keys are verbs (ATTACK, AID, etc.), values are sub-bucket labels. Required when ui.section is present.",
              "additionalProperties": {
                "type": "string"
              }
            },
            "actionCost": {
              "type": "array",
              "description": "Cost tags for UI chip display. Required when ui.section is present.",
              "items": {
                "type": "string",
                "enum": ["action", "bonus", "reaction", "move", "conc", "LoH", "CD", "L1", "L2", "L3", "L4", "L5", "free"]
              }
            },
            "hidden": {
              "type": "boolean",
              "description": "Suppress this effect from the active state display by default (toggled via eye icon)"
            },
            "displayFact": {
              "type": "string",
              "description": "Fact key to read for displaying a value on the effect chip (e.g., 'str.value')"
            },
            "displaySelection": {
              "type": "string",
              "description": "Selection key to read for displaying a value on the effect chip (e.g., 'amount')"
            },
            "levelFact": {
              "type": "string",
              "description": "Fact key to read for displaying proficiency level as pips on the effect chip (e.g., 'skill.athletics.proficiency')"
            },
            "detailKey": {
              "type": "string",
              "description": "Key for fetching detail content to display in rules mode (e.g., 'spell/sleep')"
            }
          },
          "additionalProperties": false
        },
        "vars": {
          "type": "object",
          "description": "Rule variables with default values",
          "additionalProperties": {
            "$ref": "#/definitions/varDefinition"
          }
        },
        "selections": {
          "type": "object",
          "description": "User-selected values for vars",
          "additionalProperties": true
        },
        "phase": {
          "$ref": "#/definitions/phase",
          "default": "normal"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          },
          "description": "Conditions that must be satisfied for rule execution"
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/groupReference"
          },
          "description": "Group dependencies that must settle first"
        },
        "group": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Groups this rule belongs to"
        },
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/activity"
          },
          "description": "Activities to execute when rule runs"
        }
      },
      "additionalProperties": false
    },
    "phase": {
      "type": "string",
      "enum": ["early", "normal", "safeguard"],
      "description": "Execution phase"
    },
    "groupReference": {
      "type": "object",
      "required": ["group"],
      "properties": {
        "group": {
          "type": "string",
          "description": "Group name to depend on"
        }
      },
      "additionalProperties": false
    },
    "varDefinition": {
      "type": "object",
      "required": ["default"],
      "properties": {
        "default": {
          "$ref": "#/definitions/source",
          "description": "Default value source"
        },
        "capture": {
          "type": "boolean",
          "description": "When true, capture fact value as selection when added to plan",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "description": "Target for activity operations - exactly one of fact or var must be present",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "fact": {
          "type": "string",
          "description": "Fact path to target"
        },
        "var": {
          "type": "string",
          "description": "Variable name to target"
        }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "description": "Value source - exactly one of number, fact, var, condition, string, or array must be present",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "number": {
          "type": "number",
          "description": "Literal numeric value"
        },
        "fact": {
          "type": "string",
          "description": "Reference to a fact in working state"
        },
        "var": {
          "type": "string",
          "description": "Reference to a rule variable"
        },
        "condition": {
          "$ref": "#/definitions/condition",
          "description": "Condition to evaluate, returns 1 if true, 0 if false"
        },
        "string": {
          "type": "string",
          "description": "Literal string value (typically an i18n key)"
        },
        "array": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rangeEntry"
          },
          "description": "Array of range entries for multi-range weapons"
        }
      },
      "additionalProperties": false
    },
    "rangeEntry": {
      "type": "object",
      "required": ["distance", "type"],
      "properties": {
        "distance": {
          "type": "integer",
          "description": "Range distance in feet"
        },
        "type": {
          "type": "string",
          "description": "Range type (melee, thrown, ranged)"
        },
        "disadvantage": {
          "type": "boolean",
          "description": "Whether attacks at this range have disadvantage"
        }
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "description": "Condition for when/legalWhen clauses",
      "oneOf": [
        {
          "required": ["fact"],
          "properties": {
            "fact": {
              "type": "string",
              "description": "Fact path to check"
            },
            "operator": {
              "$ref": "#/definitions/comparisonOperator"
            },
            "value": {
              "type": "number",
              "description": "Value to compare against (required when operator is present)"
            }
          }
        },
        {
          "required": ["event"],
          "properties": {
            "event": {
              "type": "string",
              "description": "Event name to check"
            }
          }
        }
      ]
    },
    "comparisonOperator": {
      "type": "string",
      "enum": [
        "equals",
        "notEquals",
        "greaterThan",
        "greaterThanOrEqual",
        "lessThan",
        "lessThanOrEqual"
      ],
      "description": "Comparison operator for fact conditions"
    },
    "activity": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this activity"
        },
        "type": {
          "type": "string",
          "enum": [
            "numberSet",
            "stringSet",
            "numberIncrement",
            "numberCopy",
            "numberSum",
            "numberFunction",
            "emitEvent",
            "generateRule",
            "offerRule",
            "setClear",
            "setAdd",
            "advertiseEffect",
            "annotate"
          ],
          "description": "Activity type"
        },
        "when": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/condition"
          },
          "description": "Conditions that must all be true for this activity to execute"
        },
        "target": {
          "$ref": "#/definitions/target",
          "description": "Target for the activity (for numberSet, numberIncrement, numberCopy, numberSum, numberFunction, setClear, setAdd)"
        },
        "source": {
          "$ref": "#/definitions/source",
          "description": "Source value reference (for numberSet, numberIncrement, numberCopy, setAdd)"
        },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/definitions/source" },
          "description": "Array of source value references (for numberSum, numberFunction)"
        },
        "max": {
          "type": "string",
          "description": "Maximum value fact path (for numberIncrement)"
        },
        "subtract": {
          "type": "boolean",
          "description": "For numberIncrement: subtract the value instead of adding",
          "default": false
        },
        "function": {
          "type": "string",
          "enum": ["statToModifier", "multiply", "max"],
          "description": "Named function (for numberFunction)"
        },
        "args": {
          "type": "object",
          "description": "Additional arguments for the function (for numberFunction)",
          "additionalProperties": true
        },
        "event": {
          "type": "string",
          "description": "Event name (for emitEvent)"
        },
        "rule": {
          "$ref": "#/definitions/rule",
          "description": "Rule to generate, offer, or advertise"
        },
        "self": {
          "type": "boolean",
          "description": "Re-advertise the current rule as a persistent effect (for advertiseEffect, mutually exclusive with rule)"
        },
        "legalWhen": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/illegalWhenEntry"
          },
          "description": "Conditions for rule legality (for offerRule)"
        },
        "key": {
          "type": "string",
          "description": "i18n key for the annotation (for annotate)"
        },
        "targets": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Annotation label targets to match (for annotate)"
        },
        "rider": {
          "$ref": "#/definitions/annotationRider",
          "description": "Optional rider data for rendering as a modifier chip (for annotate)"
        }
      },
      "additionalProperties": false
    },
    "illegalWhenEntry": {
      "type": "object",
      "required": ["condition"],
      "properties": {
        "condition": {
          "$ref": "#/definitions/condition"
        },
        "illegalDiagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/diagnostic"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "severity"],
      "properties": {
        "code": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": ["error", "warning", "notice"]
        }
      }
    },
    "annotationRider": {
      "type": "object",
      "required": ["label", "type"],
      "properties": {
        "label": {
          "type": "string",
          "description": "i18n key for the rider chip label (e.g., 'spell-bless.rider.plus-d4')"
        },
        "type": {
          "type": "string",
          "enum": ["dice", "modifier", "effect"],
          "description": "Category of rider for UI rendering"
        },
        "costTags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["action", "bonus", "reaction", "move", "conc", "LoH", "CD", "L1", "L2", "L3", "L4", "L5", "free"]
          },
          "description": "Action cost tags consumed by this rider"
        },
        "legal": {
          "type": "boolean",
          "description": "Whether this rider is currently usable. Omit or true = legal."
        },
        "illegalReason": {
          "type": "string",
          "description": "i18n key explaining why the rider is illegal (when legal is false)"
        }
      },
      "additionalProperties": false
    },
    "followup": {
      "type": "object",
      "required": ["type", "condition", "button"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["effect", "attack-line"],
          "description": "Followup action type"
        },
        "condition": {
          "$ref": "#/definitions/condition",
          "description": "Condition that must be true for the followup to be visible"
        },
        "button": {
          "type": "string",
          "description": "i18n key for the followup button label"
        },
        "addRule": {
          "type": "object",
          "description": "Rule to add when followup is triggered (for effect type)",
          "properties": {
            "target": {
              "type": "string",
              "description": "Target fact path for the added rule"
            },
            "rule": {
              "$ref": "#/definitions/rule",
              "description": "Rule to add"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "settingDefinition": {
      "type": "object",
      "required": ["id", "type", "translations", "options"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this setting within the rule group"
        },
        "type": {
          "type": "string",
          "enum": ["select", "select-rule-group"],
          "description": "Setting type: select (dropdown generating an effect) or select-rule-group (dropdown auto-assigning a rule group)"
        },
        "translations": {
          "type": "object",
          "description": "Translations for the setting label",
          "properties": {
            "en": {
              "$ref": "#/definitions/settingTranslation"
            },
            "en-x-tlh": {
              "$ref": "#/definitions/settingTranslation"
            }
          },
          "required": ["en", "en-x-tlh"],
          "additionalProperties": false
        },
        "options": {
          "type": "array",
          "description": "Available options for this setting",
          "items": {
            "$ref": "#/definitions/settingOption"
          }
        },
        "effect": {
          "$ref": "#/definitions/rule",
          "description": "Effect template using ${value} substitution. After substitution, produces a standard Rule stored as a character effect. Required when type is 'select'."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "type": { "const": "select" } }
          },
          "then": {
            "required": ["effect"]
          }
        }
      ],
      "additionalProperties": false
    },
    "settingTranslation": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display label for this setting"
        },
        "description": {
          "type": "string",
          "description": "Optional description for this setting"
        }
      },
      "additionalProperties": false
    },
    "settingOption": {
      "type": "object",
      "required": ["value", "translations"],
      "properties": {
        "value": {
          "type": "string",
          "description": "Option identifier used in ${value} substitution"
        },
        "translations": {
          "type": "object",
          "description": "Display name translations for this option",
          "properties": {
            "en": {
              "$ref": "#/definitions/settingTranslation"
            },
            "en-x-tlh": {
              "$ref": "#/definitions/settingTranslation"
            }
          },
          "required": ["en", "en-x-tlh"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "statEntry": {
      "type": "object",
      "required": ["name", "type", "section"],
      "properties": {
        "name": {
          "type": "string",
          "description": "i18n key for the stat label"
        },
        "nameParams": {
          "type": "object",
          "description": "Parameters for i18n template interpolation",
          "additionalProperties": true
        },
        "type": {
          "type": "string",
          "enum": ["value", "modifier", "usedMax", "hitDie"],
          "description": "Display type: value (plain number), modifier (+/-X), usedMax (X/Y resource), hitDie (X/Y dZ)"
        },
        "fact": {
          "type": "string",
          "description": "Fact path for value/modifier types"
        },
        "total": {
          "type": "string",
          "description": "Fact path for the total capacity (usedMax type)"
        },
        "remaining": {
          "type": "string",
          "description": "Fact path for remaining amount (usedMax type)"
        },
        "section": {
          "type": "string",
          "description": "Section name for grouping stats in the UI"
        },
        "modifierFact": {
          "type": "string",
          "description": "Fact path for the modifier display (value type only). When present with saveFact, value renders as score/modifier/save."
        },
        "saveFact": {
          "type": "string",
          "description": "Fact path for the saving throw modifier (value type only). When present with modifierFact, value renders as score/modifier/save."
        },
        "proficiencyFact": {
          "type": "string",
          "description": "Fact path for proficiency multiplier indicator (modifier type only). When present, renders a proficiency badge next to the modifier."
        },
        "dieSize": {
          "type": "integer",
          "description": "Die size for hitDie type (e.g., 6, 8, 10, 12)"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "usedMax"
