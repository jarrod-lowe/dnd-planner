{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://dnd-planner.local/rule-groups",
  "title": "D&D Planner Rule Groups",
  "description": "Schema for D&D Planner rule group YAML files",
  "type": "object",
  "required": [
    "ruleGroups"
  ],
  "properties": {
    "ruleGroups": {
      "type": "array",
      "description": "Array of rule groups to sync to DynamoDB",
      "items": {
        "$ref": "#/definitions/ruleGroup"
      }
    }
  },
  "definitions": {
    "detailLocale": {
      "type": "object",
      "description": "Translated detail content for a single locale",
      "required": [
        "body"
      ],
      "properties": {
        "meta": {
          "type": "string",
          "description": "Italic subtitle line"
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "labelKey",
              "value"
            ],
            "properties": {
              "labelKey": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "body": {
          "type": "string",
          "description": "Markdown body text"
        }
      },
      "additionalProperties": false
    },
    "translation": {
      "type": "object",
      "required": [
        "name",
        "description",
        "keywords"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display name for this rule group in this locale"
        },
        "description": {
          "type": "string",
          "description": "Description for this rule group in this locale"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Search/filter keywords for this rule group in this locale"
        }
      },
      "additionalProperties": false
    },
    "ruleGroup": {
      "type": "object",
      "required": [
        "id",
        "translations"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this rule group",
          "examples": [
            "paladin-level1-divine-sense",
            "fighter-champion-improved-critical"
          ]
        },
        "translations": {
          "type": "object",
          "description": "Translations keyed by locale code",
          "properties": {
            "en": {
              "$ref": "#/definitions/translation"
            },
            "en-x-tlh": {
              "$ref": "#/definitions/translation"
            }
          },
          "required": [
            "en",
            "en-x-tlh"
          ],
          "additionalProperties": false
        },
        "requires": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "IDs of rule groups that must also be assigned when this group is assigned"
        },
        "settings": {
          "type": "array",
          "description": "Configuration settings presented to the user when this rule group is assigned",
          "items": {
            "$ref": "#/definitions/settingDefinition"
          }
        },
        "condition": {
          "type": "array",
          "description": "Conditions that must be met before this rule group can be assigned to a character",
          "items": {
            "$ref": "#/definitions/ruleGroupCondition"
          }
        },
        "detail": {
          "type": "object",
          "description": "Detail text for rules mode (extracted by publish step, stripped before DynamoDB)",
          "required": [
            "key",
            "source",
            "translations"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "Detail key e.g. 'spell/sleep'"
            },
            "source": {
              "type": "string",
              "enum": [
                "srd52",
                "srd51",
                "custom"
              ],
              "description": "Provenance label"
            },
            "translations": {
              "type": "object",
              "description": "Map of locale code to translated detail content",
              "additionalProperties": {
                "$ref": "#/definitions/detailLocale"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ruleGroupCondition": {
      "type": "object",
      "description": "A condition for rule group assignment. Top-level array is AND logic; use type 'or' for OR logic.",
      "oneOf": [
        {
          "required": [
            "fact",
            "operator",
            "value"
          ],
          "properties": {
            "fact": {
              "type": "string",
              "description": "Fact path to check"
            },
            "operator": {
              "$ref": "#/definitions/comparisonOperator"
            },
            "value": {
              "type": "number",
              "description": "Value to compare against"
            }
          }
        },
        {
          "required": [
            "type",
            "clauses"
          ],
          "properties": {
            "type": {
              "type": "string",
              "const": "or",
              "description": "OR logic: true if any clause passes"
            },
            "clauses": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/ruleGroupCondition"
              },
              "description": "Clauses to evaluate with OR logic"
            }
          }
        }
      ]
    },
    "comparisonOperator": {
      "type": "string",
      "enum": [
        "equals",
        "notEquals",
        "greaterThan",
        "greaterThanOrEqual",
        "lessThan",
        "lessThanOrEqual"
      ],
      "description": "Comparison operator for fact conditions"
    },
    "settingDefinition": {
      "type": "object",
      "required": [
        "id",
        "type",
        "translations",
        "options"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this setting within the rule group"
        },
        "type": {
          "type": "string",
          "enum": [
            "select",
            "select-rule-group"
          ],
          "description": "Setting type: select (dropdown generating an effect) or select-rule-group (dropdown auto-assigning a rule group)"
        },
        "translations": {
          "type": "object",
          "description": "Translations for the setting label",
          "properties": {
            "en": {
              "$ref": "#/definitions/settingTranslation"
            },
            "en-x-tlh": {
              "$ref": "#/definitions/settingTranslation"
            }
          },
          "required": [
            "en",
            "en-x-tlh"
          ],
          "additionalProperties": false
        },
        "options": {
          "type": "array",
          "description": "Available options for this setting",
          "items": {
            "$ref": "#/definitions/settingOption"
          }
        },
        "effect": {
          "$ref": "#/definitions/effectInstance",
          "description": "Effect template using ${value} substitution. After substitution, produces an EffectInstance stored as a character effect. Required when type is 'select'."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "select"
              }
            }
          },
          "then": {
            "required": [
              "effect"
            ]
          }
        }
      ],
      "additionalProperties": false
    },
    "effectInstance": {
      "type": "object",
      "description": "A rules-engine EffectInstance: a committed effect that contributes fact deltas while it lives.",
      "required": [
        "id",
        "expiry"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for this effect"
        },
        "key": {
          "type": "string",
          "description": "Logical identity: effects sharing a key do not stack (newest replaces oldest)"
        },
        "ruleId": {
          "type": "string",
          "description": "Owning module id, for effects whose contribution the module parameterises"
        },
        "state": {
          "type": "object",
          "description": "Fact deltas contributed while active (summed by default)",
          "additionalProperties": {
            "type": "number"
          }
        },
        "stateCombine": {
          "type": "object",
          "description": "Per-fact combine override for state deltas (default sum)",
          "additionalProperties": {
            "enum": [
              "sum",
              "max",
              "override"
            ]
          }
        },
        "display": {
          "type": "object",
          "description": "UI metadata for the active-effects strip; hidden: true keeps the name for the reveal toggle only",
          "properties": {
            "name": {
              "type": "string",
              "description": "i18n key for the chip name"
            },
            "section": {
              "type": "string",
              "description": "Chip-kind section; must match the engine's SECTIONS union",
              "enum": [
                "action",
                "action-attack",
                "action-other",
                "action-spell",
                "bonus-action",
                "bonus-action-other",
                "bonus-action-spell",
                "configuration",
                "equip",
                "free",
                "health",
                "mastery",
                "mount",
                "move",
                "other",
                "reaction",
                "rest",
                "senses"
              ]
            },
            "displayFact": {
              "type": "string"
            },
            "hidden": {
              "type": "boolean"
            },
            "subject": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "expiry": {
          "$ref": "#/definitions/expirySpec"
        }
      },
      "additionalProperties": false
    },
    "expiry": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "permanent",
            "endOfTurn",
            "untilShortRest",
            "untilLongRest",
            "turns"
          ]
        },
        "remaining": {
          "type": "number",
          "description": "Turns remaining (only for kind: turns)"
        },
        "total": {
          "type": "number",
          "description": "Authored turns total, backfilled by endTurn aging for elapsed pips (only for kind: turns)"
        }
      },
      "additionalProperties": false
    },
    "expirySpec": {
      "description": "A single expiry condition, or several (the effect ends on the earliest to fire)",
      "oneOf": [
        {
          "$ref": "#/definitions/expiry"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/expiry"
          }
        }
      ]
    },
    "settingTranslation": {
      "type": "object",
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Display label for this setting"
        },
        "description": {
          "type": "string",
          "description": "Optional description for this setting"
        }
      },
      "additionalProperties": false
    },
    "settingOption": {
      "type": "object",
      "required": [
        "value",
        "translations"
      ],
      "properties": {
        "value": {
          "type": "string",
          "description": "Option identifier used in ${value} substitution"
        },
        "translations": {
          "type": "object",
          "description": "Display name translations for this option",
          "properties": {
            "en": {
              "$ref": "#/definitions/settingTranslation"
            },
            "en-x-tlh": {
              "$ref": "#/definitions/settingTranslation"
            }
          },
          "required": [
            "en",
            "en-x-tlh"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
