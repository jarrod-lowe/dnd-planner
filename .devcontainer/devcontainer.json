{
  "name": "dnd-planner",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges",
    "--env-file=.devcontainer/.env"
  ],
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/mnt/claude-host-config,type=bind,readonly",
    "source=/run/host-services/ssh-auth.sock,target=/run/host-services/ssh-auth.sock,type=bind",
    "source=${localEnv:HOME}/.gitconfig,target=/mnt/host-gitconfig,type=bind,readonly"
  ],
  "remoteEnv": {
    "SSH_AUTH_SOCK": "/run/host-services/ssh-auth.sock",
    "CLAUDE_CONFIG_DIR": "/workspaces/dnd-planner/.claude",
    "CLAUDE_HOST_CONFIG_STAGING": "/mnt/claude-host-config"
  },
  "initializeCommand": ".devcontainer/fetch-creds.sh",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22",
      "pnpm": "10.32.1"
    },
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.26"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3"
    },
    "ghcr.io/devcontainers/features/terraform:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "pnpm install && pnpm exec playwright install chromium && rm -rf .venv && python3 -m venv .venv && .venv/bin/pip install -q -r scripts/requirements.txt && npm install -g @anthropic-ai/claude-code",
  "postStartCommand": ".devcontainer/seed-claude-config.sh",
  "forwardPorts": [5173],
  "customizations": {
    "vscode": {
      "extensions": [
        "svelte.svelte-vscode",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "golang.go",
        "ms-python.python",
        "hashicorp.terraform",
        "hashicorp.hcl",
        "redhat.vscode-yaml",
        "vitest.explorer",
        "amazonwebservices.aws-toolkit-vscode",
        "streetsidesoftware.code-spell-checker"
      ]
    }
  }
}
